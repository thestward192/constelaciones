# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.

# Supabase (fase 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión para aplicar migraciones (Supabase > Connect > Session pooler)
SUPABASE_DB_URL=

# Panel de administración: correos permitidos, separados por coma (fase 9)
ADMIN_EMAILS=

# Secreto de la tarea de cada hora (la llama Supabase; ver docs/instagram-setup.md) (fase 10)
CRON_SECRET=

# Instagram API con inicio de sesión de Instagram (fase 10). Opcional: el token también se puede
# pegar en el panel (/admin/instagram), y la página lo renueva sola. Ver docs/instagram-setup.md
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=

# Dirección pública del sitio, para las vistas previas al compartir (fase 13)
NEXT_PUBLIC_SITE_URL=
